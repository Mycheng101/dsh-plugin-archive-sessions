{
  "name": "@local/dsh-plugin-archive-sessions",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Archived-session browser for the DeepSeek Harness Web sidebar: a workspace-grouped archive list with search, one-click unarchive, and single or batch permanent deletion.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src/host/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
